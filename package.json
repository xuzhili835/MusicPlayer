{
  "name": "sakura-echo",
  "version": "1.2.2",
  "description": "Sakura Echo - 听力 / 播客 / 音乐学习伴侣（隐私优先）",
  "main": "main.js",
  "scripts": {
    "dev": "chcp 65001 >nul 2>&1 && electron .",
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "listening",
    "podcast",
    "music",
    "study",
    "bilibili",
    "youtube"
  ],
  "author": "SakuraEcho",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "26.0.12"
  },
  "dependencies": {
    "music-metadata": "^11.6.0",
    "sqlite3": "^5.1.7",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.bilimusicplayer.sakura-echo",
    "productName": "Sakura Echo",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "**/*",
      "!build/**/*",
      "!dist/**/*",
      "!src/**/*",
      "!docs/**/*",
      "!*.md",
      "!*.log",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!temp_downloads/**/*",
      "!bin/**/*"
    ],
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/converted-image.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/converted-image.ico",
      "uninstallerIcon": "build/converted-image.ico",
      "installerHeaderIcon": "build/converted-image.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sakura Echo"
    }
  }
}
